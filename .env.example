# Root-level environment reference for the whole monorepo.
# Copy this file to `.env` (repo root) and/or into a given app as `.env.local`
# (e.g. `apps/web/.env.local`) and fill in real values. Real env files are
# git-ignored — only `.env.example` files are committed.
#
# Turborepo passes matching vars through to each task at build/dev time (see
# `turbo.json` -> tasks.*.env). Vars prefixed NEXT_PUBLIC_ are inlined into
# the browser bundle by Next.js; everything else stays server-only.

# Shared
NODE_ENV=development

# --- apps/web -----------------------------------------------------------
# See apps/web/.env.example for the full list consumed by the frontend.

# --- apps/api (reserved for a future backend) ----------------------------
# This repo has no backend yet. When one is added under apps/api (or
# apps/server), its secrets belong in apps/api/.env.example, e.g.:
# DATABASE_URL=
# API_PORT=4000
# JWT_SECRET=
