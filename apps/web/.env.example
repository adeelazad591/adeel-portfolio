# Copy to `.env.local` for local development (git-ignored). Vercel/host envs
# should set the same keys in their dashboard for production.

# Public base URL of the site, used for absolute OG/canonical URLs.
NEXT_PUBLIC_SITE_URL=https://adeelazad.com

# Google Analytics 4 measurement ID. Leave unset to disable analytics
# (e.g. in local development).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DSFYVX7Q37

# --- Reserved for when apps/api (or apps/server) exists -------------------
# Once a backend is added, the web app will likely need to know where to
# reach it, e.g.:
# NEXT_PUBLIC_API_URL=http://localhost:4000
